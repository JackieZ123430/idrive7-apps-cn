{
  "id": "draggy",
  "title": "加速计时",
  "description": "加速分段计时与历史最佳成绩",
  "version": "2.3.1-cn.1",
  "vendor": "custom",
  "loggingId": "OA94",
  "iconGlyph": "flag",
  "signals": {
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS2": {
      "statusLongitudinalAccelerationMassCenter": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "加速计时",
      "buttons": [
        ["BTN_ACTION", "重置本次"],
        ["BTN_PAGE", "下一页"],
        ["BTN_PREV", "上一页"],
        ["BTN_SETTINGS", "设置"]
      ]
    }
  ],
  "settings": [
    {"key": "speedUnit", "label": "单位", "type": "choice", "default": "kmh",
