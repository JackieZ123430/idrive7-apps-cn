{
  "id": "draggy",
  "title": "Drag Timer",
  "description": "Standing 0-100 and 1/4 mile, rolling 100-200, valid runs, slope, air and shifts per run, best times",
  "version": "2.7.2",
  "vendor": "custom",
  "loggingId": "OA94",
  "iconGlyph": "flag",
  "mguHmi": ["ID7", "ID8"],
  "requires": { "idrive7-renderd": "2.1.18", "mgu-inputgate": "1.1.0" },
  "signals": {
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS2": {
      "statusLongitudinalAccelerationMassCenter": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "_optional": "the engaged gear: upshifts then come from the rpm",
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    },
    "de.bmw.infrastructure.EnvironmentalInformation": {
      "_optional": "the outside temperature with each run (density altitude, corrected times)",
      "ExteriorTemperature": "s"
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_optional": "the outside air pressure from the engine unit (density altitude, corrected times)",
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Drag Timer",
      "buttons": [
        ["BTN_ACTION", "Reset run"],
        ["BTN_PAGE", "Next page"],
        ["BTN_PREV", "Previous page"],
        ["BTN_SETTINGS", "Settings"]
      ]
    }
  ],
  "settings": [
    {"key": "speedUnit", "label": "Speed unit", "type": "choice", "default": "kmh",
     "options": [["kmh", "km/h"], ["mph", "mph"]]},
    {"key": "distance", "label": "Longest distance", "type": "choice", "default": "qm", "aliases": {"em": "qm"},
     "options": [["qm", "1/4 mile"], ["m1000", "1000 m"], ["hm", "1/2 mile"]]},
    {"key": "rollout", "label": "One-foot rollout", "type": "bool", "default": false},
    {"key": "slopeLimit", "label": "Downhill limit for best times", "type": "choice", "default": "2",
     "options": [["1", "1 %"], ["2", "2 %"], ["off", "Off"]]},
    {"key": "air", "label": "Outside air with each run", "type": "choice", "default": "show",
     "options": [["show", "Show (pressure from the engine unit)"], ["sae", "Show, times corrected to standard air (SAE J1349)"], ["off", "Off (no engine unit requests)"]]},
    {"key": "highSpeed", "label": "250-300 km/h window (160-190 mph)", "type": "bool", "default": false},
    {"key": "custom", "label": "Custom speed window", "type": "bool", "default": false},
    {"key": "customFrom", "label": "Custom window from (km/h or mph)", "type": "number", "default": 0,
     "steps": [0, 20, 30, 40, 50, 60, 70, 80, 100, 120, 130, 150, 200], "when": {"custom": true}},
    {"key": "customTo", "label": "Custom window to (km/h or mph)", "type": "number", "default": 150,
     "steps": [30, 40, 50, 60, 70, 80, 100, 110, 120, 130, 150, 160, 180, 200, 220, 250, 300], "when": {"custom": true}},
    {"key": "advanced", "label": "Advanced settings", "type": "bool", "default": false},
    {"key": "theme", "label": "Colour theme", "type": "choice", "default": "m_tricolour",
     "options": [["m_red", "M Red"], ["m_tricolour", "M Tricolour"], ["ice", "Ice White"], ["amber", "Night Amber"]]},
    {"key": "speedRate", "label": "Speed display rate", "type": "number", "unit": "fps", "default": 10, "reset": 1, "markDefault": true, "steps": [5, 10, 15, 30, 60], "when": {"advanced": true}},
    {"key": "layout", "label": "Screen layout", "type": "choice", "default": "full",
     "options": [["full", "Full screen"], ["standard", "Standard"]]},
    {"key": "renderer", "label": "Renderer", "type": "choice", "default": "auto",
     "options": [["auto", "GPU 60 fps (default)"], ["software", "Software"]]},
    {"key": "demo", "label": "Demo data", "type": "choice", "default": "auto",
     "options": [["auto", "Auto"], ["on", "Always"], ["off", "Never"]]}
  ],
  "config": {
    "comment": "BMW's own scalings (M Laptimer TypeConverters). baro: the outside air pressure, kPa, read from the engine unit (baroEcu, decimal: 18 = DME 0x12) as Car Vitals does, every 5 min at most and never during a run; candidates in order, the first plausible one wins.",
    "baroEcu": 18,
    "baro": [
      {"did": "F433", "bytes": 1, "at": 0, "factor": 1, "offset": 0, "min": 50, "max": 115, "note": "OBD PID 0x33 barometric pressure, kPa"},
      {"obd": "33", "bytes": 1, "at": 0, "factor": 1, "offset": 0, "min": 50, "max": 115, "note": "OBD service 01 PID 0x33 (same as F433)"}
    ],
    "scaling": {
      "speed": {"factor": 0.015625, "offset": 0, "invalid": 65535},
      "accel": {"factor": 0.002, "offset": -65, "invalid": 65535},
      "rpm": {"factor": 0.25, "offset": 0, "invalid": 65535}
    }
  }
}
