    {"key": "distance", "label": "距离分段", "type": "choice", "default": "qm",
     "options": [["qm", "1/4 英里"], ["em", "1/8 英里"], ["m1000", "1000 m"]]},
    {"key": "rollout", "label": "一英尺起步豁免", "type": "bool", "default": false},
    {"key": "theme", "label": "配色主题", "type": "choice", "default": "m_tricolour",
     "options": [["m_red", "M 红色"], ["m_tricolour", "M 三色"], ["ice", "冰晶白"], ["amber", "夜间琥珀"]]},
    {"key": "speedRate", "label": "速度刷新率", "type": "number", "unit": "fps", "default": 10, "reset": 1, "markDefault": true, "steps": [5, 10, 15, 30, 60]},
    {"key": "layout", "label": "屏幕布局", "type": "choice", "default": "full",
     "options": [["full", "全屏"], ["standard", "标准"]]},
    {"key": "renderer", "label": "渲染器", "type": "choice", "default": "auto",
     "options": [["auto", "GPU 60 帧（默认）"], ["software", "软件渲染"]]},
    {"key": "demo", "label": "演示数据", "type": "choice", "default": "auto",
     "options": [["auto", "自动"], ["on", "始终"], ["off", "从不"]]}
  ],
  "config": {
    "comment": "BMW's own scalings (M Laptimer TypeConverters)",
    "scaling": {
      "speed": {"factor": 0.015625, "offset": 0, "invalid": 65535},
      "accel": {"factor": 0.002, "offset": -65, "invalid": 65535},
      "rpm": {"factor": 0.25, "offset": 0, "invalid": 65535}
    }
