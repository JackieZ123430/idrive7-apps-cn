        [
          "BTN_SELECT",
          "下一项"
        ],
        [
          "BTN_ACTION",
          "查看／刷新"
        ],
        [
          "BTN_SETTINGS",
          "设置"
        ]
      ]
    }
  ],
  "settings": [
