{
  "id": "gforce",
  "title": "G 值仪表",
  "description": "显示摩擦圆、各方向峰值 G 值和驾驶记录。",
  "version": "1.6.2201",
  "vendor": "custom",
  "loggingId": "OA9B",
  "iconGlyph": "gforce",
  "mguHmi": [
    "ID7",
    "ID8"
  ],
  "requires": {
    "idrive7-renderd": "2.1.15"
  },
  "signals": {
    "de.bmw.infotainment.vehicle.CDS2": {
      "statusLongitudinalAccelerationMassCenter": "rs",
      "statusLateralAccelerationMassCenter": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "G 值仪表",
      "buttons": [
        [
          "BTN_ACTION",
          "重置峰值"
        ],
        [
          "BTN_PAGE",
          "下一页"
        ],
        [
          "BTN_PREV",
          "上一页"
        ],
        [
          "BTN_SETTINGS",
          "设置"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "scale",
      "label": "圆盘量程",
      "type": "number",
      "unit": "g",
      "default": 1.5,
      "steps": [
        1.0,
        1.5,
        2.0
      ]
    },
    {
      "key": "trail",
      "label": "轨迹长度",
      "type": "number",
      "unit": "s",
      "default": 4,
      "steps": [
        2,
        4,
        8,
        15
      ]
    },
    {
      "key": "flipLat",
      "label": "交换左右方向",
      "type": "bool",
      "default": false
    },
    {
      "key": "flipLong",
      "label": "交换加速和制动（制动在上）",
      "type": "bool",
      "default": false
    },
    {
      "key": "speedUnit",
      "label": "速度单位",
      "type": "choice",
      "default": "kmh",
      "options": [
        [
          "kmh",
          "km/h"
        ],
        [
          "mph",
          "mph"
        ]
      ]
    },
    {
      "key": "advanced",
      "label": "高级设置",
      "type": "bool",
      "default": false
    },
    {
      "key": "theme",
      "label": "配色主题",
      "type": "choice",
      "default": "m_tricolour",
      "options": [
        [
          "m_red",
          "M 红色"
        ],
        [
          "m_tricolour",
          "M 三色"
        ],
        [
          "ice",
          "冰晶白"
        ],
        [
          "amber",
          "夜间琥珀"
        ]
      ]
    },
    {
      "key": "gRate",
      "label": "G 值刷新率",
      "type": "number",
      "unit": "fps",
      "default": 10,
      "markDefault": true,
      "steps": [
        5,
        10,
        15,
        30,
        60
      ],
      "when": {
        "advanced": true
      }
    },
    {
      "key": "layout",
      "label": "屏幕布局",
      "type": "choice",
      "default": "full",
      "options": [
        [
          "full",
          "全屏"
        ],
        [
          "standard",
          "标准"
        ]
      ]
    },
    {
      "key": "renderer",
      "label": "渲染器",
      "type": "choice",
      "default": "auto",
      "options": [
        [
          "auto",
          "GPU 60 帧（默认）"
        ],
        [
          "software",
          "软件渲染"
        ]
      ]
    },
    {
      "key": "demo",
      "label": "演示数据",
      "type": "choice",
      "default": "auto",
      "options": [
        [
          "auto",
          "自动"
        ],
        [
          "on",
          "始终"
        ],
        [
          "off",
          "从不"
        ]
      ]
    }
  ]
}
