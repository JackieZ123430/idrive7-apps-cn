  "config": {
    "comment": "raw -> value*factor + offset. CDS/CDS2/Vehicle2/ambient factors are BMW's own (M Laptimer's TypeConverters). FES boost and BasicDataSet scalings are best guesses: calibrate here against a known reading.",
    "scaling": {
      "rpm": {
        "factor": 0.25,
        "offset": 0,
        "invalid": 65535
      },
      "speed": {
        "factor": 0.015625,
        "offset": 0,
        "invalid": 65535
      },
      "accel": {
        "factor": 0.002,
        "offset": -65,
        "invalid": 65535
      },
      "ambient": {
        "factor": 0.5,
        "offset": -40,
        "invalid": 255
      },
      "engineTemp": {
        "factor": 1,
        "offset": -48,
        "invalid": 255
      },
      "gearboxTemp": {
        "factor": 1,
        "offset": -48,
        "invalid": 255,
        "note": "a value that never changes is shown as no data (some cars don't fill this field); raw values go to the log ('raw gearbox oil')"
      },
      "boost": {
        "factor": 0.01,
        "offset": 0,
        "invalid": 255,
        "note": "sport display boost; raw values go to the log ('raw FES boost')"
      },
      "torque": {
        "factor": 0.5,
        "offset": -1023.5,
        "invalid": 65535,
        "invalidFrom": 4095,
        "note": "12 bit, 0.5 Nm per bit, 0 Nm at raw 2047 (negative = engine braking), 4095 = no value. With factor 1 a running engine read as ~2047 Nm."
      },
      "tyreTemp": {
        "factor": 1,
        "offset": -40,
        "invalid": 65535,
        "note": "deg C + 40: a G05 PHEV sent raw 53-57 on a ~10 deg C day (2.8.0 log), not deci-Kelvin. Values outside -40..150 deg C are shown as no data; the raw values go to the log ('raw tyre temperature')"
      },
      "torqueSplitRear": {
        "factor": 0.01,
        "offset": 0,
        "invalid": 65535
      },
      "tyrePress": {
        "factor": 0.1,
        "offset": 0,
        "invalidFrom": 65532,
        "note": "0.1 bar per bit (BMW x_call: raw * 0.1, valid up to 530; a car sent raw 22-25 = 2.2-2.5 bar). Read as 0.1 kPa before, every tyre came out at 0.02 bar and was hidden."
      },
      "sportPct": {
        "factor": 1,
        "offset": 0,
        "invalid": 255,
        "note": "sport display power / torque in % of the car maximum; calibrate if the raw value is not 0-100"
      }
    },
    "xdrive": {
      "comment": "xDrive split straight from the transfer case unit (LMV, address 0x19), read on the Chassis page when the car's own split signal has nothing. LMV_MOMENT (22 DB32): actual torque to the front axle, signed, Nm = raw / 4 (bytes 0-1); qualifier bytes 2-3, target torque 4-5 (layout from BMW's LMV_G11 description). Split % = front torque / (engine torque x gear ratio): an estimate (no converter multiplication, no losses).",
      "front": [
        {"ecu": 25, "did": "DB32", "bytes": 2, "at": 0, "factor": 0.25, "signed": true, "min": -200, "max": 2500, "note": "LMV_MOMENT.ISTMOMENT, actual torque to the front axle"}
      ],
      "gearRatios": [5.0, 3.2, 2.143, 1.72, 1.313, 1.0, 0.823, 0.64],
      "gearRatiosNote": "ZF 8HP, 1st..8th"
    },
    "dme": {
      "comment": "Intake / fuel values from the engine unit (DME, ecu 18 = 0x12) with UDS 0x22. F4xx = the standard OBD PIDs (F40F = PID 0x0F); a candidate with \"obd\" instead of \"did\" asks for the same PID with OBD service 01 (some engine units refuse the F4xx identifiers with NRC 31). Candidates are tried in order; the first plausible one wins. value = raw * factor + offset (bar / deg C). If a tile says 'not available from this DME', add your engine's BMW-specific DID here. boost: tried in order when the sport display sends no boost (setting 'Boost from'); absolute pressure in kPa, the outside air pressure (baro) is subtracted. timing: OBD PID 0x0E, degrees before top dead centre. misfire: OBD service 06 monitor results (MID A2 = cylinder 1, A3 = cylinder 2 ...), tid 0C = misfires this driving cycle (0B = average of the last 10 cycles); engine units that only speak UDS are asked 0x22 F6A2... egs: gearbox temperature from the gearbox unit (EGS); give each candidate its \"ecu\".",
      "ecu": 18,
      "iat": [
        {
          "did": "F40F",
          "bytes": 1,
          "at": 0,
          "factor": 1,
          "offset": -40,
          "min": -40,
          "max": 150
        },
        {
          "did": "F477",
          "bytes": 1,
          "at": 1,
          "factor": 1,
          "offset": -40,
          "min": -40,
          "max": 150,
          "note": "charge air cooler temperature, bank 1 sensor 1"
        },
        {
          "obd": "0F",
          "bytes": 1,
          "at": 0,
          "factor": 1,
          "offset": -40,
          "min": -40,
          "max": 150,
          "note": "the same PID with OBD service 01, for engine units that refuse F40F with NRC 31"
        }
      ],
      "hpfp": [
        {
          "did": "F423",
          "bytes": 2,
          "at": 0,
          "factor": 0.1,
          "offset": 0,
          "min": 0,
          "max": 500,
          "note": "fuel rail gauge pressure (direct injection), 10 kPa per bit"
        },
        {
          "did": "F459",
          "bytes": 2,
          "at": 0,
          "factor": 0.1,
          "offset": -1,
          "min": 0,
          "max": 500,
          "note": "fuel rail absolute pressure, 10 kPa per bit"
        },
        {
          "obd": "23",
          "bytes": 2,
          "at": 0,
          "factor": 0.1,
          "offset": 0,
          "min": 0,
          "max": 500,
          "note": "OBD service 01 PID 0x23 (same as F423)"
        }
      ],
      "lpfp": [
        {
          "did": "F40A",
          "bytes": 1,
          "at": 0,
          "factor": 0.03,
          "offset": 0,
          "min": 0.5,
          "max": 8,
          "note": "fuel pressure (gauge), 3 kPa per bit"
        },
        {
          "did": "F422",
          "bytes": 2,
          "at": 0,
          "factor": 0.00079,
          "offset": 0,
          "min": 0.5,
          "max": 15,
          "note": "fuel rail pressure relative to manifold, 0.079 kPa per bit"
        },
        {
          "obd": "0A",
          "bytes": 1,
          "at": 0,
          "factor": 0.03,
          "offset": 0,
          "min": 0.5,
          "max": 8,
          "note": "OBD service 01 PID 0x0A (same as F40A)"
        },
        {
          "obd": "22",
          "bytes": 2,
          "at": 0,
          "factor": 0.00079,
          "offset": 0,
          "min": 0.5,
          "max": 15,
          "note": "OBD service 01 PID 0x22 (same as F422)"
        }
      ],
      "oil": [
        {
          "obd": "5C",
          "bytes": 1,
          "at": 0,
          "factor": 1,
          "offset": -40,
          "min": -40,
          "max": 170,
          "note": "engine oil temperature, OBD service 01 PID 0x5C - only read while the car's own signal (CDS) sends none"
        },
        {
          "did": "F45C",
          "bytes": 1,
          "at": 0,
          "factor": 1,
          "offset": -40,
          "min": -40,
          "max": 170
        }
      ],
      "boost": [
        {
          "did": "F470",
          "bytes": 2,
          "at": 5,
          "factor": 0.03125,
          "offset": 0,
          "min": 20,
          "max": 600,
          "note": "OBD PID 0x70 boost pressure control: actual boost pressure sensor A (absolute), 1/32 kPa"
        },
        {
          "did": "F487",
          "bytes": 2,
          "at": 1,
          "factor": 0.03125,
          "offset": 0,
          "min": 20,
          "max": 600,
          "note": "OBD PID 0x87 intake manifold absolute pressure sensor A, 1/32 kPa"
        },
        {
          "did": "F40B",
          "bytes": 1,
          "at": 0,
          "factor": 1,
          "offset": 0,
          "min": 20,
