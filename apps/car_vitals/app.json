  "config": {
    "comment": "raw -> value*factor + offset. CDS/CDS2/Vehicle2/ambient factors are BMW's own (M Laptimer's TypeConverters). FES boost and BasicDataSet scalings are best guesses: calibrate here against a known reading.",
    "scaling": {
      "rpm": {
        "factor": 0.25,
        "offset": 0,
        "invalid": 65535
      },
      "speed": {
        "factor": 0.015625,
        "offset": 0,
        "invalid": 65535
      },
      "accel": {
        "factor": 0.002,
        "offset": -65,
        "invalid": 65535
      },
      "ambient": {
        "factor": 0.5,
        "offset": -40,
        "invalid": 255
      },
      "engineTemp": {
        "factor": 1,
        "offset": -48,
        "invalid": 255
      },
      "gearboxTemp": {
        "factor": 1,
        "offset": -48,
        "invalid": 255
      },
      "boost": {
        "factor": 0.01,
        "offset": 0,
        "invalid": 255
      },
      "torque": {
        "factor": 1,
        "offset": 0,
        "invalid": 65535
      },
      "tyreTemp": {
        "factor": 0.1,
        "offset": -273.15,
        "invalid": 65535,
        "note": "UInt16; assumed deci-Kelvin - calibrate"
      },
      "torqueSplitRear": {
        "factor": 0.01,
        "offset": 0,
        "invalid": 65535
      },
      "tyrePress": {
        "factor": 0.001,
        "offset": 0,
        "invalidFrom": 65532,
        "note": "raw*0.1 = kPa (BMW x_call); stored in bar"
      },
      "sportPct": {
        "factor": 1,
        "offset": 0,
        "invalid": 255,
        "note": "sport display power / torque in % of the car maximum; calibrate if the raw value is not 0-100"
      }
    },
    "dme": {
      "comment": "Intake / fuel values from the engine unit (DME, ecu 18 = 0x12) with UDS 0x22. F4xx = the standard OBD PIDs (F40F = PID 0x0F). Candidates are tried in order; the first plausible one wins. value = raw * factor + offset (bar / deg C). If a tile says 'not available from this DME', add your engine's BMW-specific DID here.",
      "ecu": 18,
      "iat": [
        {
          "did": "F40F",
          "bytes": 1,
          "at": 0,
          "factor": 1,
          "offset": -40,
          "min": -40,
          "max": 150
        },
        {
          "did": "F477",
          "bytes": 1,
          "at": 1,
          "factor": 1,
          "offset": -40,
          "min": -40,
          "max": 150,
          "note": "charge air cooler temperature, bank 1 sensor 1"
        }
      ],
      "hpfp": [
        {
          "did": "F423",
          "bytes": 2,
          "at": 0,
          "factor": 0.1,
          "offset": 0,
          "min": 0,
          "max": 500,
          "note": "fuel rail gauge pressure (direct injection), 10 kPa per bit"
        },
        {
          "did": "F459",
          "bytes": 2,
          "at": 0,
          "factor": 0.1,
          "offset": -1,
          "min": 0,
          "max": 500,
          "note": "fuel rail absolute pressure, 10 kPa per bit"
        }
      ],
      "lpfp": [
        {
          "did": "F40A",
          "bytes": 1,
          "at": 0,
          "factor": 0.03,
          "offset": 0,
          "min": 0.5,
          "max": 8,
          "note": "fuel pressure (gauge), 3 kPa per bit"
        },
        {
          "did": "F422",
          "bytes": 2,
          "at": 0,
          "factor": 0.00079,
          "offset": 0,
          "min": 0.5,
          "max": 15,
          "note": "fuel rail pressure relative to manifold, 0.079 kPa per bit"
        }
      ]
    }
  }
