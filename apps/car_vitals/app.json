  "config": {
    "comment": "raw -> value*factor + offset. CDS/CDS2/Vehicle2/ambient factors are BMW's own (M Laptimer's TypeConverters). FES boost and BasicDataSet scalings are best guesses: calibrate here against a known reading.",
    "scaling": {
      "rpm": {
        "factor": 0.25,
        "offset": 0,
        "invalid": 65535
      },
      "speed": {
        "factor": 0.015625,
        "offset": 0,
        "invalid": 65535
      },
      "accel": {
        "factor": 0.002,
        "offset": -65,
        "invalid": 65535
      },
      "ambient": {
        "factor": 0.5,
        "offset": -40,
        "invalid": 255
      },
      "engineTemp": {
        "factor": 1,
        "offset": -48,
        "invalid": 255
      },
      "gearboxTemp": {
        "factor": 1,
        "offset": -48,
        "invalid": 255
      },
      "boost": {
        "factor": 0.01,
        "offset": 0,
        "invalid": 255
      },
      "torque": {
        "factor": 1,
        "offset": 0,
        "invalid": 65535
      },
      "tyreTemp": {
        "factor": 0.1,
        "offset": -273.15,
        "invalid": 65535,
        "note": "UInt16; assumed deci-Kelvin - calibrate"
      },
      "torqueSplitRear": {
        "factor": 0.01,
        "offset": 0,
        "invalid": 65535
      },
      "tyrePress": {
        "factor": 0.001,
        "offset": 0,
        "invalidFrom": 65532,
        "note": "raw*0.1 = kPa (BMW x_call); stored in bar"
      }
    }
  }
