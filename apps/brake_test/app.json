{
  "id": "brake_test",
  "title": "制动测试",
  "description": "制动距离、减速度与制动衰减测试",
  "version": "1.3.1-cn.1",
  "vendor": "custom",
  "loggingId": "OA99",
  "iconGlyph": "brake",
  "signals": {
