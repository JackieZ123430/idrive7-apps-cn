    {"key": "layout", "label": "屏幕布局", "type": "choice", "default": "full",
     "options": [["full", "全屏"], ["standard", "标准"]]},
    {"key": "renderer", "label": "渲染器", "type": "choice", "default": "auto",
     "options": [["auto", "GPU 60 帧（默认）"], ["software", "软件渲染"]]},
    {"key": "demo", "label": "演示数据", "type": "choice", "default": "auto",
     "options": [["auto", "自动"], ["on", "始终"], ["off", "从不"]]}
