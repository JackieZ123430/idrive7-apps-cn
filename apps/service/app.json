{
  "id": "service",
  "title": "Service",
  "description": "Service requirements from the instrument cluster: oil, brakes, brake fluid, vehicle check, inspection - distance, date and details",
  "version": "1.1.1-cn.3",
  "vendor": "custom",
  "loggingId": "OA96",
  "iconGlyph": "wrench",
  "signals": {
    "de.bmw.infotainment.KombiInterface_2": {
      "cbsDataServiceList": "rs",
      "cbsDataSBA": "rs",
      "_methods": ["requestCBSServiceHint"]
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Service",
      "buttons": [
        ["BTN_SELECT", "Next item"],
        ["BTN_DETAILS", "Details"],
        ["BTN_PAGE", "Next page"],
        ["BTN_SETTINGS", "Settings"]
      ]
    }
  ],
  "settings": [
    {
      "key": "language",
      "label": "Language / 语言",
      "type": "choice",
      "default": "en",
      "options": [
        [
          "en",
          "English"
        ],
        [
          "zh-CN",
          "中文"
        ]
      ]
    },
    {"key": "diagPage", "label": "Diagnostics page", "type": "bool", "default": false},
    {"key": "theme", "label": "Colour theme", "type": "choice", "default": "m_tricolour",
     "options": [["m_red", "M Red"], ["m_tricolour", "M Tricolour"], ["ice", "Ice White"], ["amber", "Night Amber"]]},
    {"key": "layout", "label": "Screen layout", "type": "choice", "default": "full",
     "options": [["full", "Full screen"], ["standard", "Standard"]]},
    {"key": "renderer", "label": "Renderer", "type": "choice", "default": "auto",
     "options": [["auto", "GPU 60 fps (default)"], ["software", "Software"]]},
    {"key": "demo", "label": "Demo data", "type": "choice", "default": "auto",
     "options": [["auto", "Auto"], ["on", "Always"], ["off", "Never"]]}
  ]
}
