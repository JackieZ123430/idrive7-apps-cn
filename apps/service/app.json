{
  "id": "service",
  "title": "Service",
  "description": "Service items (CBS) from the instrument cluster: what is due when, reset an item after a service, set the inspection dates",
  "version": "1.0.1",
  "vendor": "custom",
  "loggingId": "OA9D",
  "iconGlyph": "service",
  "signals": {
    "de.bmw.infotainment.KombiInterface_2": { "cbsDataServiceList": "rs" },
    "de.bmw.infotainment.ConditionBasedServicesLegacy": {
      "cBSMessageEngineOil": "s", "cBSMessageBrakeFront": "s", "cBSMessageBrakeRear": "s",
      "cBSMessageGearOil": "s", "cBSMessageParticleFilter": "s", "cBSMessageSparkPlug": "s",
      "cBSReset": "w"
    },
    "de.bmw.infotainment.KombiIF": { "terminCBS": "w" }
  },
  "screens": [
    { "name": "MAIN", "kind": "canvas", "title": "Service",
      "buttons": [["BTN_NEXT", "Next item"], ["BTN_RESET", "Reset item"], ["BTN_DATES", "Inspection dates"], ["BTN_SETTINGS", "Settings"]] },
    { "name": "DATES", "kind": "canvas", "title": "Inspection dates",
      "buttons": [["BTN_FIELD", "Next field"], ["BTN_UP", "+1"], ["BTN_DOWN", "-1"], ["BTN_SAVE", "Save date"]] }
  ],
  "settings": [
    {"key": "theme", "label": "Colour theme", "type": "choice", "default": "m_tricolour",
     "options": [["m_red", "M Red"], ["m_tricolour", "M Tricolour"], ["ice", "Ice White"], ["amber", "Night Amber"]]},
    {"key": "layout", "label": "Screen layout", "type": "choice", "default": "full",
     "options": [["full", "Full screen"], ["standard", "Standard"]]},
    {"key": "renderer", "label": "Renderer", "type": "choice", "default": "auto",
     "options": [["auto", "GPU 60 fps (default)"], ["software", "Software"]]},
    {"key": "demo", "label": "Demo data", "type": "choice", "default": "auto",
     "options": [["auto", "Auto"], ["on", "Always"], ["off", "Never"]]}
  ]
}
