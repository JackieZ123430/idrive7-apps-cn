{
  "schema": 1,
  "apps": {
    "path": "apps/*",
    "manifest": "app.json",
    "icon": "icon.png",
    "mguHmi": ["ID7"],
    "requires": { "mgu-render": "0.5.3", "mgu-inputgate": "1.0.0" },
    "build": {
      "python": "kit/tools/build.py",
      "args": ["{id}"],
      "sdk": "oap-sdk",
      "output": "dist/{id}@{version}.tgz",
      "network": ["doom"]
    }
  },
  "tools": [
    {
      "id": "idrive7-renderd",
      "path": "kit/renderd/prebuilt",
      "title": "GPU renderer (kit)",
      "description": "Only if the apps' screen does not show: if your screen works, do not install it. The kit's own copy of mgu-render; the Store's Renderer is used otherwise",
      "optional": true,
      "provides": "renderer",
      "mguHmi": ["ID7"]
    },
    {
      "id": "mgu-inputgate",
      "path": "kit/renderd/prebuilt",
      "version": "1.0.0",
      "title": "Controller gate",
      "description": "Lets the apps have the iDrive controller (tabs, page buttons, settings, Doom); loads into the HMI at the next start",
      "needs": ["renderer"],
      "requires": { "mgu-render": "0.5.3" },
      "optional": false,
      "mguHmi": ["ID7"],
      "preload": {
        "library": "mgu-inputgate.so",
        "unit": "hmi.service",
        "process": "HmiMain3D",
        "strikes": 2,
        "checkAfterSeconds": 120,
        "healthySeconds": 60
      }
    }
  ]
}
